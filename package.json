{
  "name": "bilismooth",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "Smoother Bilibili playback for overseas viewers.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node --test --test-reporter=tap \"test/unit/*.test.js\"",
    "test:workflow": "node --test --test-reporter=tap \"test/workflow/*.test.js\"",
    "test:ui": "node --test --test-reporter=tap \"test/browser/*.test.js\"",
    "check": "node scripts/check.mjs",
    "check:playback": "node scripts/check.mjs playback",
    "check:compare": "node scripts/check.mjs compare",
    "check:4k": "node scripts/check.mjs 4k",
    "check:cdn": "node scripts/check.mjs cdn",
    "check:recovery": "node scripts/check.mjs recovery",
    "check:lifecycle": "node scripts/check.mjs lifecycle",
    "check:control": "node scripts/check.mjs control",
    "check:ui": "node scripts/check.mjs ui",
    "check:theme": "node scripts/check.mjs theme",
    "check:viewport": "node scripts/check.mjs viewport",
    "check:surface": "node scripts/check.mjs surface",
    "check:xhr": "node scripts/check.mjs xhr",
    "check:benchmark": "node scripts/check.mjs benchmark",
    "commit": "node scripts/commit.mjs",
    "commit:check": "node scripts/commit.mjs check",
    "package": "node scripts/release.mjs package",
    "verify:package": "node scripts/release.mjs verify-package",
    "release:check": "node scripts/release.mjs check",
    "release": "node scripts/release.mjs publish",
    "release:verify": "node scripts/release.mjs verify",
    "store:artwork": "node scripts/store.mjs artwork",
    "store:capture": "node scripts/store.mjs capture",
    "store:demo": "node scripts/store.mjs demo",
    "prepare": "npm run build"
  },
  "keywords": [
    "bilibili",
    "chrome",
    "cdn",
    "edge",
    "webextension"
  ],
  "license": "MIT",
  "dependencies": {
    "motion": "13.2.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright": "1.62.1"
  },
  "homepage": "https://github.com/Planetes1mal/BiliSmooth",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Planetes1mal/BiliSmooth.git"
  },
  "bugs": {
    "url": "https://github.com/Planetes1mal/BiliSmooth/issues"
  }
}
